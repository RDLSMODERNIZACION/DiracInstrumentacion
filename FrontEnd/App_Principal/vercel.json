{
  "routes": [
    {
      "src": "/instrumentacionlogin/?",
      "dest": "/index.html"
    },
    {
      "src": "/login/?",
      "dest": "/index.html"
    },
    {
      "src": "/ahorroenergetico",
      "dest": "https://ahorro-energetico.vercel.app/ahorroenergetico"
    },
    {
      "src": "/ahorroenergetico/(.*)",
      "dest": "https://ahorro-energetico.vercel.app/ahorroenergetico/$1"
    },
    {
      "src": "/cargaderosdeagua",
      "dest": "https://cargaderoagua.vercel.app/cargaderosdeagua/admin/dispatches"
    },
    {
      "src": "/cargaderosdeagua/(.*)",
      "dest": "https://cargaderoagua.vercel.app/cargaderosdeagua/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/kpi/.*",
      "dest": "/kpi/index.html"
    }
  ]
}
